OPENAI_API_KEY = "YOUR_OPENAI_API_KEY"
OPENAI_MODEL = "gpt-4o-mini"

NEO4J_URI = "bolt://localhost:7687"
NEO4J_USERNAME = "neo4j"
NEO4J_PASSWORD = "YOUR_NEO4J_PASSWORD"
NEO4J_DATABASE = "neo4j"

# Optional: direct Bolt URI override (bypasses routing discovery).
# Useful if `neo4j+s://...` works in Neo4j Browser but fails locally with
# "Unable to retrieve routing information".
# NEO4J_DIRECT_URI = "bolt+s://p-<instance>-<region>.neo4j.io:7687"

# Optional: Neo4j vector index config for semantic search.
# Set these to match your real estate graph.
NEO4J_VECTOR_INDEX_NAME = "realEstateIndex"
NEO4J_VECTOR_NODE_LABEL = "Listing"
NEO4J_VECTOR_TEXT_PROPERTY = "description"
NEO4J_VECTOR_EMBEDDING_PROPERTY = "descriptionEmbedding"

# Optional: custom retrieval query. Uncomment and tailor if you want custom metadata.
# NEO4J_VECTOR_RETRIEVAL_QUERY = """
# RETURN
#   node[$text_node_property] AS text,
#   score,
#   properties(node) AS metadata
# """
